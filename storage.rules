rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Authenticated users can upload their own PDFs from the browser
    match /course-pdfs/{userId}/{filename} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Authenticated users can upload their own MinerU layout JSON from the browser
    match /course-layouts/{userId}/{filename} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // All other paths are locked — reads go through the server-side Admin SDK proxy
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
