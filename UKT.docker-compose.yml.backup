version: "3.9"

services:
  ukt-api:
    build: .
    ports:
      - "8000:8000"
    environment:
      - REDIS_URL=redis://redis:6379
      - UKT_CHECKPOINT_PATH=model/checkpoints/ukt_best.pt
    volumes:
      # Mount checkpoint khi có model thật
      - ./model/checkpoints:/app/model/checkpoints:ro
    depends_on:
      redis:
        condition: service_healthy
    restart: unless-stopped

  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5
    restart: unless-stopped
